{
  "name": "csedu-nexus-backend",
  "version": "1.0.0",
  "description": "CSEDU Nexus backend API (Express + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seeds/seedBaseData.js",
    "grant-admin": "node src/scripts/grantSystemAdmin.js",
    "fix-batch": "node src/scripts/fixBatchAndSession.js",
    "fix-student-ids": "node src/scripts/fixStudentIdFormat.js",
    "env:local": "node switch-env.js local && echo 'Now run: npm run dev'",
    "env:prod": "node switch-env.js production && echo 'Now run: npm start'",
    "dev:local": "node switch-env.js local && npm run dev",
    "start:prod": "node switch-env.js production && npm start"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "html-pdf-node": "^1.0.8",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.14",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "sslcommerz-lts": "^1.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}

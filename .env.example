# ── Docker Compose root .env ─────────────────────────────────────────────────
# Copy this to .env and fill in your values before running docker compose up

# The public URL of your backend API (used by the frontend Vite build)
# On a real server this should be your domain, e.g. https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=http://YOUR_SERVER_IP:5000/api/v1

# ── Email Configuration (SMTP) ────────────────────────────────────────────────
# Used for email verification, password reset, and notifications
# See backend/.env.example for detailed email configuration

# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="CSEDU Nexus <your-email@gmail.com>"

# For Custom SMTP:
# SMTP_HOST=smtp.your-domain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@your-domain.com
# SMTP_PASS=your-password
# SMTP_FROM="CSEDU Nexus <noreply@your-domain.com>"
